# Server only. Never prefix this key with VITE_ or put it in browser code.
GOOGLE_PLACES_API_KEY=
# Demo is available without a key. Live mode requires a key.
PORT=3000
HOST=127.0.0.1
# Exact browser origin. Change together with host/port behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
API_TIMEOUT_MS=8000
REDIRECT_TIMEOUT_MS=5000
MAX_REDIRECTS=4
RATE_LIMIT_PER_15_MIN=30
# Upstream attempts per UTC day, per process; 0 disables live calls.
# Restarts reset this memory counter. Set Google Cloud quotas as the hard cap.
DAILY_GOOGLE_REQUEST_CAP=100
